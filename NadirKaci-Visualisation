# This script loads job market data and generates 4 visualisations:
# 1. Top 10 jobs most at risk of automation
# 2. Salary vs automation risk
# 3. Salary distribution by risk category
# 4. AI exposure by education level


import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

# Load dataset containing job info (salary, automation risk, AI exposure, etc.)
df = pd.read_csv('data/data.csv')

# Chart 1 - Top 10 most at risk jobs
top10 = df.nlargest(10, 'Automation_Probability_2030')
plt.figure(figsize=(10, 6))
plt.barh(top10['Job_Title'], top10['Automation_Probability_2030'], color='steelblue')
plt.xlabel('Automation Probability by 2030')
plt.title('Top 10 Jobs Most Likely to be Automated by 2030')
plt.tight_layout()
plt.savefig('automation_risk.png')
plt.show()
plt.close()

# Chart 2 - Salary vs Automation Risk
plt.figure(figsize=(9, 6))
plt.scatter(df['Average_Salary'], df['Automation_Probability_2030'], alpha=0.6, color='coral')
plt.xlabel('Average Salary ($)')
plt.ylabel('Automation Probability 2030')
plt.title('Does Higher Salary Mean Lower Automation Risk?')
plt.savefig('salary_vs_automation.png')
plt.show()
plt.close()

# Chart 3 - Salary by Risk Category
plt.figure(figsize=(8, 6))
sns.boxplot(data=df, x='Risk_Category', y='Average_Salary', palette='Set2')
plt.title('Salary Distribution by AI Risk Category')
plt.xlabel('Risk Category')
plt.ylabel('Average Salary ($)')
plt.savefig('salary_by_risk.png')
plt.show()
plt.close()

# Chart 4 - AI Exposure by Education Level
edu_group = df.groupby('Education_Level')['AI_Exposure_Index'].mean().sort_values()
plt.figure(figsize=(8, 5))
edu_group.plot(kind='bar', color='mediumpurple')
plt.title('Average AI Exposure Index by Education Level')
plt.xlabel('Education Level')
plt.ylabel('AI Exposure Index')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('exposure_by_education.png')
plt.show()
plt.close()
